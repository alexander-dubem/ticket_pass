# Shared environment configuration for the Ticket Pass monorepo.
# Copy this file to `.env` at the repo root and fill in your own values.
#
# This single file is shared by both apps:
#   - apps/api (NestJS) loads it via @nestjs/config (ConfigModule)
#   - apps/web (Next.js) loads it via dotenv-cli before the `next` command runs
#
# NEVER commit `.env`. Only `.env.example` is tracked.

# --- API (NestJS) ---
# Port the NestJS API listens on
PORT=5001

# PostgreSQL connection string (see apps/api/prisma/schema.prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ticket_pass?schema=public"

# Stellar SEP-10 signing keypair seed used to build the auth challenge transaction.
# Generate with: stellar keygen  (or: npx @stellar/stellar-sdk keygen)
SECRET_SEP10_SIGNING_SEED="S..."

# Secret used to sign and verify auth JWTs. Use a long random string in production.
# Generate with: openssl rand -hex 32
SECRET_SEP10_JWT_SECRET="super-secret-jwt-key-change-this-in-production"

# Stellar sponsor account secret key, used to pay transaction fees and fund minting.
# Must be funded on the Stellar testnet.
SPONSOR_SECRET_KEY="S..."

# --- Web (Next.js) ---
# Base URL of the NestJS API. MUST be prefixed NEXT_PUBLIC_ so the browser can read it.
NEXT_PUBLIC_API_URL="http://localhost:5001"
